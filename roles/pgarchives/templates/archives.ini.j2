[db]
connstr=dbname={{ database_name_pgarchives }}

[smtp]
server=localhost:9911
heloname=localhost
resender=noreply@example.com

[pglister]
{% if pgarchives_pglister_sync_use_host %}
root=https://localhost
host={{ service_vhost_name_pglister }}
{% else %}
root=https://{{ service_vhost_name_pglister }}
host=
{% endif %}
{% if pgarchives_private is defined and pgarchives_private == 'True' %}
myname=pgarchivesprivate
subscribers=1
{% else %}
myname=pgarchives
subscribers=0
{% endif %}
apikey={{ pgarchives_secret_key }}
